<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Oracle.ManagedDataAccess.Core 23.4.0: versión mínima disponible sin la
      vulnerabilidad conocida de 2.19.x. Soporte para Oracle 11g a nivel de
      protocolo de red (ODP.NET Managed es backward-compatible). Testeá la
      conectividad real con tu instancia Oracle 11g al ejecutar por primera vez.
    -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.4.0" />
    <PackageReference Include="NHibernate" Version="5.5.2" />
    <PackageReference Include="FluentNHibernate" Version="3.4.0" />
  </ItemGroup>

</Project>
